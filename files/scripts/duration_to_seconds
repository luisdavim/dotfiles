#! /usr/bin/env bash

function to_seconds() {
  echo "${1}" |
    sed -Ee '
      s/[1-9][0-9]*[dhms]/&+ /g
      :a;s/[+]([^+].*)/\1+/;ta
      s/.$//
      :loop
        s/d/ 24h*/
        s/h/ 60m*/
        s/m/ 60s*/
        s/s//
      t loop
      s/.*/echo "&" | dc -e "?p"/e
    '
}

function replace() {
  duration="$(echo "${*}" | grep -Eo '(\s|^)([0-9]+[smhd]+)+(\s|$)')"
  if [ -z "${duration}" ]; then
    echo "${*}"
    return
  fi
  duration=$(awk '{$1=$1};1' <<< "${duration}")
  seconds=$(to_seconds "${duration}")
  echo "${*//$duration/$seconds}"
}

if [ -n "${*}" ]; then
  replace "${*}"
  exit
fi

while IFS=$'\n' read -r line; do
  replace "${line}"
done
